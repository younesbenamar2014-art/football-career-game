<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<title>Football Career</title>

<style>
body {
    font-family: Arial;
    background: #07111f;
    color: white;
    text-align: center;
    margin: 0;
}

header {
    background: #102a43;
    padding: 20px;
}

h1 {
    margin: 0;
}

button {
    background: #168aad;
    color: white;
    border: none;
    padding: 12px 20px;
    margin: 8px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background: #0d6e8a;
}

#game {
    padding: 25px;
}

.club {
    background: #132238;
    padding: 15px;
    margin: 10px auto;
    max-width: 400px;
    border-radius: 10px;
}

.player {
    background: #1b3049;
    padding: 15px;
    margin: 10px auto;
    max-width: 500px;
    border-radius: 10px;
}
</style>
</head>

<body>

<header>
    <h1>⚽ Football Career</h1>
    <p id="budget">Transferbudget: €100M</p>
</header>

<div id="game">

    <h2>Kies je club</h2>

    <div class="club">
        <h3>🔵🔴 FC Barcelona</h3>
        <button onclick="kiesClub('FC Barcelona')">Kiezen</button>
    </div>

    <div class="club">
        <h3>⚪ Real Madrid</h3>
        <button onclick="kiesClub('Real Madrid')">Kiezen</button>
    </div>

    <div class="club">
        <h3>🔵 Manchester City</h3>
        <button onclick="kiesClub('Manchester City')">Kiezen</button>
    </div>

    <div class="club">
        <h3>🔴 Liverpool</h3>
        <button onclick="kiesClub('Liverpool')">Kiezen</button>
    </div>

    <hr>

    <h2>🔎 Transfermarkt</h2>

    <div class="player">
        <h3>⭐ Lamine Yamal</h3>
        <p>Positie: RW | Rating: 89</p>
        <p>Waarde: €120M</p>
        <button onclick="koopSpeler('Lamine Yamal', 120)">
            Kopen
        </button>
    </div>

    <div class="player">
        <h3>⚡ Kylian Mbappé</h3>
        <p>Positie: ST | Rating: 91</p>
        <p>Waarde: €180M</p>
        <button onclick="koopSpeler('Kylian Mbappé', 180)">
            Kopen
        </button>
    </div>

    <div class="player">
        <h3>🎯 Pedri</h3>
        <p>Positie: CM | Rating: 89</p>
        <p>Waarde: €100M</p>
        <button onclick="koopSpeler('Pedri', 100)">
            Kopen
        </button>
    </div>

    <p id="bericht"></p>

</div>

<script>

let budget = 100;
let mijnClub = "";

function kiesClub(club) {
    mijnClub = club;

    document.getElementById("bericht").innerText =
        "✅ Je hebt " + club + " gekozen!";

    alert("Welkom bij " + club + "!");
}

function koopSpeler(naam, prijs) {

    if (mijnClub === "") {
        document.getElementById("bericht").innerText =
            "❌ Kies eerst een club!";
        return;
    }

    if (budget >= prijs) {

        budget = budget - prijs;

        document.getElementById("budget").innerText =
            "Transferbudget: €" + budget + "M";

        document.getElementById("bericht").innerText =
            "✅ " + naam + " is gekocht door " + mijnClub + "!";

    } else {

        document.getElementById("bericht").innerText =
            "❌ Je hebt niet genoeg geld!";
    }
}

</script>

</body>
</html>
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<title>Football Career</title>

<style>
body {
