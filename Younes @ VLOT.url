        oninput="toonSpelers()"
    >

    <select id="positie" onchange="toonSpelers()">
        <option value="Alle">Alle posities</option>
        <option value="GK">Keeper</option>
        <option value="DEF">Verdediger</option>
        <option value="MID">Middenvelder</option>
        <option value="ATT">Aanvaller</option>
    </select>

    <select id="rating" onchange="toonSpelers()">
        <option value="0">Alle ratings</option>
        <option value="85">85+</option>
        <option value="88">88+</option>
        <option value="90">90+</option>
    </select>

    <div id="spelers"></div>

    <p id="bericht"></p>

</div>

<script>

let budget = 100;
let mijnClub = "FC Barcelona";

let spelers = [

    {
        naam: "Lamine Yamal",
