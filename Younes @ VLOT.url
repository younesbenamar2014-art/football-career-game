    <p id="bericht"></p>

    <script>
        function nieuweCarriere() {
            document.getElementById("bericht").innerText =
                "Je nieuwe carrière is gestart! ⚽";
        }

        function spelersZoeken() {
            document.getElementById("bericht").innerText =
                "Spelers zoeken komt eraan! 🔎";
