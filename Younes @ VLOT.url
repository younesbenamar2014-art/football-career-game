        rating: 89,
        prijs: 60
    }

];


function toonSpelers() {

    let zoek = document.getElementById("zoek").value.toLowerCase();

    let positie = document.getElementById("positie").value;

    let rating = Number(document.getElementById("rating").value);

    let container = document.getElementById("spelers");

    container.innerHTML = "";


    let gevonden = spelers.filter(function(speler) {

        let naamGoed =
            speler.naam.toLowerCase().includes(zoek);

        let positieGoed =
            positie === "Alle" ||
            speler.positie === positie;

        let ratingGoed =
            speler.rating >= rating;

        return naamGoed && positieGoed && ratingGoed;

    });


    if (gevonden.length === 0) {

        container.innerHTML =
            "<p>❌ Geen spelers gevonden.</p>";

        return;
    }


    gevonden.forEach(function(speler) {

        let div = document.createElement("div");

        div.className = "player";

        div.innerHTML = `

            <h3>⭐ ${speler.naam}</h3>

            <p>
            Positie: ${speler.positie}
            </p>

            <p class="rating">
            ⭐ ${speler.rating}
            </p>

            <p>
            💰 Waarde: €${speler.prijs}M
            </p>

            <button onclick="koopSpeler('${speler.naam}', ${speler.prijs})">
                🔄 Kopen
            </button>

        `;

        container.appendChild(div);

    });

}


function koopSpeler(naam, prijs) {

    if (budget >= prijs) {

        budget -= prijs;

        document.getElementById("budget").innerText =
            "💰 Transferbudget: €" + budget + "M";

        document.getElementById("bericht").innerText =
            "✅ " + naam + " is gekocht door " + mijnClub + "!";

    } else {

        document.getElementById("bericht").innerText =
            "❌ Niet genoeg geld voor " + naam + "!";

    }

}


function toonTransfermarkt() {

    document.getElementById("bericht").innerText =
        "🔄 Transfermarkt geopend!";

    toonSpelers();

}


document.getElementById("club").innerText =
    "🏟️ Club: " + mijnClub;

toonSpelers();

</script>

</body>
</html>

