    <div id="game">
    <h2>🏟️ Kies je club</h2>

<select id="clubKiezen" onchange="selecteerClub()">
    <option value="">-- Kies een club --</option>
</select>

<p id="gekozenClub"></p>
const clubMenu = document.getElementById("clubKiezen");

clubs.forEach(function(club) {

    let optie = document.createElement("option");

    optie.value = club.naam;

    optie.textContent =
        club.naam + " 🇺🇳 - " + club.competitie;

    clubMenu.appendChild(optie);

});


function selecteerClub() {

    let gekozen = clubMenu.value;

    if (gekozen === "") {
        return;
    }

    let club = clubs.find(function(c) {
        return c.naam === gekozen;
    });

    mijnClub = club.naam;
    budget = club.budget;

    document.getElementById("gekozenClub").innerText =
        "✅ Je speelt met " + club.naam +
        " | 💰 Budget: €" + club.budget + "M";

    document.getElementById("club").innerText =
        "🏟️ Club: " + club.naam;

    document.getElementById("budget").innerText =
        "💰 Transferbudget: €" + club.budget + "M";
        let mijnSelectie = [];
        function koopSpeler(naam, prijs) {

    if (budget < prijs) {
        document.getElementById("bericht").innerText =
            "❌ Je hebt niet genoeg geld!";
        return;
    }

    let speler = spelers.find(function(speler) {
        return speler.naam === naam;
    });

    if (!speler) {
        return;
    }

    budget -= prijs;

    mijnSelectie.push(speler);

    document.getElementById("budget").innerText =
        "💰 Transferbudget: €" + budget + "M";

    document.getElementById("bericht").innerText =
        "✅ " + speler.naam + " is naar " + mijnClub + " gekomen!";

    toonSelectie();
    <h2>👥 Mijn selectie</h2>

<div id="selectie"></div>
function toonSelectie() {

    let selectie = document.getElementById("selectie");

    selectie.innerHTML = "";

    if (mijnSelectie.length === 0) {

        selectie.innerHTML =
            "<p>Je hebt nog geen nieuwe spelers gekocht.</p>";

        return;
    }

    mijnSelectie.forEach(function(speler) {

        let div = document.createElement("div");

        div.className = "player";

        div.innerHTML = `
            <h3>⭐ ${speler.naam}</h3>
            <p>⚽ Positie: ${speler.positie}</p>
            <p>⭐ Rating: ${speler.rating}</p>
        `;

        selectie.appendChild(div)
        <h2>🏆 Wedstrijd</h2>

<div id="wedstrijd"></div>

<button onclick="speelWedstrijd()">▶️ Speel wedstrijd</button>

<h2>📊 Competitiestand</h2>

<div id="stand"></div>
let punten = 0;
let gespeeld = 0;
let gewonnen = 0;
let gelijk = 0;
let verloren = 0;
let voor = 0;
let tegen = 0;

let tegenstanders = [
    "Real Madrid",
    "Manchester City",
    "Liverpool",
    "Bayern München",
    "PSG",
    "Inter",
    "Arsenal",
    "AC Milan"
];

function speelWedstrijd() {

    let tegenstander =
        tegenstanders[Math.floor(Math.random() * tegenstanders.length)];

    let mijnGoals = Math.floor(Math.random() * 5);
    let tegenGoals = Math.floor(Math.random() * 5);

    gespeeld++;

    voor += mijnGoals;
    tegen += tegenGoals;

    let resultaat = "";

    if (mijnGoals > tegenGoals) {

        gewonnen++;
        punten += 3;

        resultaat = "🟢 GEWONNEN!";

    } else if (mijnGoals === tegenGoals) {

        gelijk++;
        punten += 1;

        resultaat = "🟡 GELIJKGESPEELD!";

    } else {

        verloren++;

        resultaat = "🔴 VERLOREN!";

    }

    document.getElementById("wedstrijd").innerHTML = `
        <div class="player">
            <h3>${mijnClub} 🆚 ${tegenstander}</h3>
            <h2>${mijnGoals} - ${tegenGoals}</h2>
            <p>${resultaat}</p>
        </div>
    `;

    toonStand();
}


function toonStand() {

    let doelsaldo = voor - tegen;

    document.getElementById("stand").innerHTML = `
        <div class="player">

            <h3>🏟️ ${mijnClub}</h3>

            <p>🎮 Wedstrijden: ${gespeeld}</p>

            <p>🟢 Gewonnen: ${gewonnen}</p>

            <p>🟡 Gelijk: ${gelijk}</p>

            <p>🔴 Verloren: ${verloren}</p>

            <p>⚽ Doelpunten: ${voor}</p>

            <p>🥅 Tegendoelpunten: ${tegen}</p>

            <p>📈 Doelsaldo: ${doelsaldo}</p>

            <h2>🏆 Punten: ${punten}</h2>

        </div>
        let competitie = [
    { club: "FC Barcelona", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Real Madrid", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Atlético Madrid", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Athletic Bilbao", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Real Sociedad", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Real Betis", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Villarreal", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Sevilla", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Valencia", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Girona", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Celta Vigo", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Getafe", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Osasuna", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Mallorca", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Rayo Vallecano", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Alavés", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Espanyol", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Levante", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Elche", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 },
    { club: "Deportivo", WG: 0, W: 0, G: 0, V: 0, DV: 0, DT: 0 }
];


function speelWedstrijd() {

    let mijnTeam = competitie.find(c => c.club === mijnClub);

    if (!mijnTeam) {
        mijnTeam = competitie[0];
        mijnClub = mijnTeam.club;
    }

    let mogelijkeTegenstanders =
        competitie.filter(c => c.club !== mijnClub);

    let tegenstander =
        mogelijkeTegenstanders[
            Math.floor(Math.random() * mogelijkeTegenstanders.length)
        ];

    let mijnGoals = Math.floor(Math.random() * 5);
    let tegenGoals = Math.floor(Math.random() * 5);

    mijnTeam.WG++;
    tegenstander.WG++;

    mijnTeam.DV += mijnGoals;
    mijnTeam.DT += tegenGoals;

    tegenstander.DV += tegenGoals;
    tegenstander.DT += mijnGoals;


    if (mijnGoals > tegenGoals) {

        mijnTeam.W++;
        tegenstander.V++;

    } else if (mijnGoals < tegenGoals) {

        mijnTeam.V++;
        tegenstander.W++;

    } else {

        mijnTeam.G++;
        tegenstander.G++;

    }


    document.getElementById("wedstrijd").innerHTML = `
        <div class="player">
            <h3>${mijnClub} 🆚 ${tegenstander.club}</h3>
            <h2>${mijnGoals} - ${tegenGoals}</h2>
        </div>
    `;

    toonStand();
}


function toonStand() {

    competitie.forEach(team => {

        team.DS = team.DV - team.DT;

        team.Ptn =
            (team.W * 3) +
            team.G;

    });


    competitie.sort((a, b) => {

        if (b.Ptn !== a.Ptn)
            return b.Ptn - a.Ptn;

        if (b.DS !== a.DS)
            return b.DS - a.DS;

        return b.DV - a.DV;

    });


    let html = `
        <table style="
            width:100%;
            border-collapse:collapse;
            background:#132238;
            border-radius:10px;
            overflow:hidden;
        ">

        <tr style="background:#168aad;">
            <th>#</th>
            <th>Club</th>
            <th>WG</th>
            <th>W</th>
            <th>G</th>
            <th>V</th>
            <th>DV</th>
            <th>DT</th>
            <th>DS</th>
            <th>Ptn</th>
        </tr>
    `;


    competitie.forEach((team, index) => {

        let positie = index + 1;

        let achtergrond = "";

        if (team.club === mijnClub) {
            achtergrond = "background:#244b63;";
        }

        html += `
            <tr style="${achtergrond}">
                <td>${positie}</td>
                <td style="text-align:left;">
                    ${team.club}
                </td>
                <td>${team.WG}</td>
                <td>${team.W}</td>
                <td>${team.G}</td>
                <td>${team.V}</td>
                <td>${team.DV}</td>
                <td>${team.DT}</td>
                <td>${team.DS}</td>
                <td><b>${team.Ptn}</b></td>
            </tr>
        `;
    });


    html += `</table>`;

    document.getElementById("stand").innerHTML = html;
    function speelWedstrijd() {
    let mijnTeam = competitie.find(c => c.club === mijnClub);

    if (!mijnTeam) {
        alert("Je club zit niet in deze competitie!");
        return;
    }

    // Maak een lijst van alle teams
    let teams = [...competitie];

    // Zet jouw team bovenaan
    teams.sort((a, b) => {
        if (a.club === mijnClub) return -1;
        if (b.club === mijnClub) return 1;
        return 0;
    });

    // Zoek een tegenstander voor jouw wedstrijd
    let mogelijkeTegenstanders =
        competitie.filter(c => c.club !== mijnClub);

    let tegenstander =
        mogelijkeTegenstanders[
            Math.floor(Math.random() * mogelijkeTegenstanders.length)
        ];

    // Jouw wedstrijd
    let mijnGoals = Math.floor(Math.random() * 5);
    let tegenGoals = Math.floor(Math.random() * 5);

    verwerkWedstrijd(
        mijnTeam,
        tegenstander,
        mijnGoals,
        tegenGoals
    );

    // Speel automatisch andere wedstrijden
    let andereTeams = competitie.filter(
        c => c.club !== mijnClub && c.club !== tegenstander.club
    );

    // Shuffle de teams
    andereTeams.sort(() => Math.random() - 0.5);

    let automatischeWedstrijden = [];

    while (andereTeams.length >= 2) {
        let thuis = andereTeams.shift();
        let uit = andereTeams.shift();

        let goalsThuis = Math.floor(Math.random() * 5);
        let goalsUit = Math.floor(Math.random() * 5);

        verwerkWedstrijd(
            thuis,
            uit,
            goalsThuis,
            goalsUit
        );

        automatischeWedstrijden.push({
            thuis: thuis.club,
            uit: uit.club,
            score: goalsThuis + " - " + goalsUit
        });
    }

    // Toon jouw wedstrijd
    let html = `
        <div class="player">
            <h3>${mijnClub} 🆚 ${tegenstander.club}</h3>
            <h2>${mijnGoals} - ${tegenGoals}</h2>
        </div>

        <h3>📅 Andere wedstrijden</h3>
    `;

    automatischeWedstrijden.forEach(wedstrijd => {
        html += `
            <p>
                ⚽ ${wedstrijd.thuis}
                ${wedstrijd.score}
                ${wedstrijd.uit}
            </p>
        `;
    });

    document.getElementById("wedstrijd").innerHTML = html;

    toonStand();
}


// Wedstrijd verwerken
function verwerkWedstrijd(thuis, uit, goalsThuis, goalsUit) {

    thuis.WG++;
    uit.WG++;

    thuis.DV += goalsThuis;
    thuis.DT += goalsUit;

    uit.DV += goalsUit;
    uit.DT += goalsThuis;

    if (goalsThuis > goalsUit) {

        thuis.W++;
        uit.V++;

    } else if (goalsThuis < goalsUit) {

        uit.W++;
        thuis.V++;

    } else {

        thuis.G++;
        uit.G++;
    }
}
}



	
    `;
}

toonStand();
}
}
];
let speeldag = 0;
let wedstrijden = [];

// Maak alle wedstrijden voor het seizoen
function maakSeizoen() {
    wedstrijden = [];

    for (let i = 0; i < competitie.length; i++) {
        for (let j = i + 1; j < competitie.length; j++) {

            // Eerste wedstrijd: i thuis
            wedstrijden.push({
                thuis: competitie[i].club,
                uit: competitie[j].club,
                gespeeld: false
            });

            // Tweede wedstrijd: j thuis
            wedstrijden.push({
                thuis: competitie[j].club,
                uit: competitie[i].club,
                gespeeld: false
            });
        }
    }

    // Door elkaar zodat het seizoen verschillende wedstrijden heeft
    wedstrijden.sort(() => Math.random() - 0.5);

    speeldag = 0;
}

// Eén wedstrijd verwerken
function verwerkWedstrijd(thuis, uit, goalsThuis, goalsUit) {

    thuis.WG++;
    uit.WG++;

    thuis.DV += goalsThuis;
    thuis.DT += goalsUit;

    uit.DV += goalsUit;
    uit.DT += goalsThuis;

    if (goalsThuis > goalsUit) {
        thuis.W++;
        uit.V++;
    } 
    else if (goalsThuis < goalsUit) {
        uit.W++;
        thuis.V++;
    } 
    else {
        thuis.G++;
        uit.G++;
    }
}


// Speeldag spelen
function speelSpeeldag() {

    if (speeldag >= 38) {
        document.getElementById("wedstrijd").innerHTML =
            "<h2>🏆 Het seizoen is afgelopen!</h2>";
        return;
    }

    speeldag++;

    // Zoek 10 wedstrijden die nog niet gespeeld zijn
    let wedstrijdenVandaag = wedstrijden
        .filter(w => !w.gespeeld)
        .slice(0, 10);

    let html = `
        <h2>📅 Speeldag ${speeldag} / 38</h2>
    `;

    wedstrijdenVandaag.forEach(wedstrijd => {

        let thuis = competitie.find(
            c => c.club === wedstrijd.thuis
        );

        let uit = competitie.find(
            c => c.club === wedstrijd.uit
        );

        let goalsThuis = Math.floor(Math.random() * 5);
        let goalsUit = Math.floor(Math.random() * 5);

        verwerkWedstrijd(
            thuis,
            uit,
            goalsThuis,
            goalsUit
        );

        wedstrijd.gespeeld = true;

        html += `
            <p>
                ⚽ <b>${thuis.club}</b>
                ${goalsThuis} - ${goalsUit}
                <b>${uit.club}</b>
            </p>
        `;
    });

    document.getElementById("wedstrijd").innerHTML = html;

    toonStand();
<button onclick="speelSpeeldag()">
    ▶️ Speel volgende speeldag
</button>maakSeizoen();
toonStand();
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Football Career Mode</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #07111f;
    color: white;
}

header {
    background: #0d1b2a;
    padding: 20px;
    text-align: center;
    border-bottom: 2px solid #168aad;
}

nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px;
    background: #10243a;
    justify-content: center;
}

button, select, input {
    padding: 10px;
    border-radius: 8px;
    border: none;
    margin: 4px;
}

button {
    background: #168aad;
    color: white;
    cursor: pointer;
    font-weight: bold;
}

button:hover {
    background: #126782;
}

main {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
}

.card {
    background: #10243a;
    padding: 15px;
    margin: 12px 0;
    border-radius: 12px;
}

.player {
    background: #172d46;
    padding: 12px;
    margin: 8px 0;
    border-radius: 10px;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: #10243a;
}

th, td {
    padding: 8px;
    border-bottom: 1px solid #29445e;
    text-align: center;
}

th {
    background: #168aad;
}

.highlight {
    background: #244b63;
}

.green {
    color: #4ade80;
}

.red {
    color: #f87171;
}

.hidden {
    display: none;
}

.statbox {
    display: inline-block;
    background: #172d46;
    padding: 12px;
    margin: 5px;
    border-radius: 10px;
}
</style>
</head>

<body>

<header>
    <h1>⚽ Football Career Mode</h1>
    <p id="status">Nieuwe carrière</p>
</header>

<nav>
    <button onclick="pagina('home')">🏠 Home</button>
    <button onclick="pagina('team')">👥 Selectie</button>
    <button onclick="pagina('transfers')">🔄 Transfers</button>
    <button onclick="pagina('wedstrijden')">⚽ Wedstrijden</button>
    <button onclick="pagina('stand')">📊 Stand</button>
    <button onclick="pagina('competities')">🏆 Competities</button>
    <button onclick="pagina('nieuws')">📰 Nieuws</button>
</nav>

<main>

<!-- HOME -->
<section id="home">

    <div class="card">
        <h2>🏟️ Kies je club</h2>

        <select id="clubKiezen">
            <option value="">-- Kies een club --</option>
        </select>

        <button onclick="startCarriere()">Start carrière</button>

        <p id="gekozenClub"></p>
    </div>

    <div class="card">
        <h2>📊 Carrière</h2>

        <div class="statbox">
            💰 Budget: €<span id="budget">0</span>M
        </div>

        <div class="statbox">
            📅 Seizoen: <span id="seizoen">1</span>
        </div>

        <div class="statbox">
            📆 Speeldag: <span id="speeldag">0</span>/38
        </div>

        <div class="statbox">
            🏆 Titels: <span id="titels">0</span>
        </div>
    </div>

</section>


<!-- TEAM -->
<section id="team" class="hidden">

    <div class="card">
        <h2>👥 Mijn selectie</h2>
        <div id="selectie"></div>
    </div>

</section>


<!-- TRANSFERS -->
<section id="transfers" class="hidden">

    <div class="card">

        <h2>🔎 Transfermarkt</h2>

        <input
            id="zoekSpeler"
            placeholder="Zoek speler..."
            oninput="toonTransfers()"
        >

        <select id="positieFilter" onchange="toonTransfers()">
            <option value="">Alle posities</option>
            <option value="GK">GK</option>
            <option value="DEF">DEF</option>
            <option value="MID">MID</option>
            <option value="ATT">ATT</option>
        </select>

        <div id="transferLijst"></div>

    </div>

</section>


<!-- WEDSTRIJDEN -->
<section id="wedstrijden" class="hidden">

    <div class="card">

        <h2>⚽ Wedstrijden</h2>

        <button onclick="speelSpeeldag()">
            ▶️ Speel volgende speeldag
        </button>

        <button onclick="nieuweWedstrijd()">
            🎲 Speel mijn wedstrijd
        </button>

        <div id="wedstrijd"></div>

    </div>

</section>


<!-- STAND -->
<section id="stand" class="hidden">

    <div class="card">

        <h2>📊 Competitiestand</h2>

        <div id="standTabel"></div>

    </div>

</section>


<!-- COMPETITIES -->
<section id="competities" class="hidden">

    <div class="card">

        <h2>🏆 Competities</h2>

        <h3>🇪🇸 LaLiga</h3>
        <p>20 clubs • 38 wedstrijden</p>

        <h3>🌍 Champions League</h3>
        <p>Wordt gespeeld vanaf seizoen 2.</p>

        <h3>🏆 Beker</h3>
        <p>De nationale beker wordt later in het seizoen gespeeld.</p>

    </div>

</section>


<!-- NIEUWS -->
<section id="nieuws" class="hidden">

    <div class="card">

        <h2>📰 Voetbalnieuws</h2>

        <div id="nieuwsLijst"></div>

    </div>

</section>

</main>


<script>

/* =========================
   SPELERS
========================= */

let spelers = [

{
naam:"Lamine Yamal",
club:"FC Barcelona",
positie:"ATT",
rating:89,
prijs:120
},

{
naam:"Pedri",
club:"FC Barcelona",
positie:"MID",
rating:89,
prijs:100
},

{
naam:"Frenkie de Jong",
club:"FC Barcelona",
positie:"MID",
rating:87,
prijs:75
},

{
naam:"Kylian Mbappé",
club:"Real Madrid",
positie:"ATT",
rating:91,
prijs:180
},

{
naam:"Vinícius Jr.",
club:"Real Madrid",
positie:"ATT",
rating:90,
prijs:170
},

{
naam:"Jude Bellingham",
club:"Real Madrid",
positie:"MID",
rating:90,
prijs:160
},

{
naam:"Erling Haaland",
club:"Manchester City",
positie:"ATT",
rating:91,
prijs:190
},

{
naam:"Phil Foden",
club:"Manchester City",
positie:"ATT",
rating:88,
prijs:130
},

{
naam:"Rodri",
club:"Manchester City",
positie:"MID",
rating:90,
prijs:130
},

{
naam:"Mohamed Salah",
club:"Liverpool",
positie:"ATT",
rating:89,
prijs:100
},

{
naam:"William Saliba",
club:"Arsenal",
positie:"DEF",
rating:87,
prijs:90
},

{
naam:"Harry Kane",
club:"Bayern München",
positie:"ATT",
rating:90,
prijs:110
},

{
naam:"Jamal Musiala",
club:"Bayern München",
positie:"MID",
rating:88,
prijs:130
},

{
naam:"Ousmane Dembélé",
club:"PSG",
positie:"ATT",
rating:88,
prijs:100
},

{
naam:"Achraf Hakimi",
club:"PSG",
positie:"DEF",
rating:88,
prijs:80
},

{
naam:"Lautaro Martínez",
club:"Inter",
positie:"ATT",
rating:89,
prijs:110
},

{
naam:"Thibaut Courtois",
club:"Real Madrid",
positie:"GK",
rating:89,
prijs:60
},

{
naam:"Alisson",
club:"Liverpool",
positie:"GK",
rating:89,
prijs:70
},

{
naam:"Theo Hernández",
club:"AC Milan",
positie:"DEF",
rating:86,
prijs:70
},

{
naam:"Rúben Dias",
club:"Manchester City",
positie:"DEF",
rating:88,
prijs:90
}

];


/* =========================
   CLUBS
========================= */

let clubs = [

"FC Barcelona",
"Real Madrid",
"Atlético Madrid",
"Athletic Bilbao",
"Real Sociedad",
"Real Betis",
"Villarreal",
"Sevilla",
"Valencia",
"Girona",
"Celta Vigo",
"Getafe",
"Osasuna",
"Mallorca",
"Rayo Vallecano",
"Alavés",
"Espanyol",
"Levante",
"Elche",
"Deportivo"

];


/* =========================
   SPELSTATUS
========================= */

let mijnClub = "";
let budget = 100;
let seizoen = 1;
let speeldag = 0;
let titels = 0;

let mijnSelectie = [];


/* =========================
   COMPETITIE
========================= */

let competitie = clubs.map(club => ({
    club: club,
    WG: 0,
    W: 0,
    G: 0,
    V: 0,
    DV: 0,
    DT: 0,
    DS: 0,
    Ptn: 0
}));


/* =========================
   CLUBMENU
========================= */

let menu = document.getElementById("clubKiezen");

clubs.forEach(club => {

    let optie = document.createElement("option");

    optie.value = club;
    optie.textContent = club;

    menu.appendChild(optie);

});


/* =========================
   PAGINA
========================= */

function pagina(naam) {

    document.querySelectorAll("main section")
        .forEach(section => section.classList.add("hidden"));

    document.getElementById(naam)
        .classList.remove("hidden");

    if (naam === "team") toonSelectie();
    if (naam === "transfers") toonTransfers();
    if (naam === "stand") toonStand();
    if (naam === "nieuws") toonNieuws();

}


/* =========================
   CARRIÈRE STARTEN
========================= */

function startCarriere() {

    let gekozen = menu.value;

    if (!gekozen) {

        alert("Kies eerst een club!");

        return;
    }

    mijnClub = gekozen;

    document.getElementById("gekozenClub").innerText =
        "✅ Je bent manager van " + mijnClub;

    document.getElementById("status").innerText =
        mijnClub + " • Seizoen " + seizoen;

    // Geef eigen spelers
    mijnSelectie = spelers.filter(
        speler => speler.club === mijnClub
    );

    updateStatus();

    toonSelectie();

    alert(
        "Carrière gestart met " +
        mijnClub +
        "!"
    );

}


/* =========================
   STATUS
========================= */

function updateStatus() {

    document.getElementById("budget")
        .innerText = budget;

    document.getElementById("seizoen")
        .innerText = seizoen;

    document.getElementById("speeldag")
        .innerText = speeldag;

    document.getElementById("titels")
        .innerText = titels;

}


/* =========================
   SELECTIE
========================= */

function toonSelectie() {

    let box =
        document.getElementById("selectie");

    box.innerHTML = "";

    if (mijnSelectie.length === 0) {

        box.innerHTML =
            "<p>Je selectie is nog leeg.</p>";

        return;
    }

    mijnSelectie.forEach((speler, index) => {

        box.innerHTML += `

        <div class="player">

            <h3>
                ⭐ ${speler.naam}
            </h3>

            <p>
                Positie: ${speler.positie}
            </p>

            <p>
                Rating: ${speler.rating}
            </p>

            <button onclick="verkoopSpeler(${index})">
                💰 Verkoop voor €${Math.round(speler.prijs * 0.7)}M
            </button>

        </div>

        `;

    });

}


/* =========================
   TRANSFERS
========================= */

function toonTransfers() {

    let zoek =
        document.getElementById("zoekSpeler")
        .value
        .toLowerCase();

    let positie =
        document.getElementById("positieFilter")
        .value;

    let box =
        document.getElementById("transferLijst");

    box.innerHTML = "";

    spelers
        .filter(speler =>
            speler.naam.toLowerCase().includes(zoek)
        )
        .filter(speler =>
            positie === "" ||
            speler.positie === positie
        )
        .forEach(speler => {

            let alInSelectie =
                mijnSelectie.some(
                    p => p.naam === speler.naam
                );

            box.innerHTML += `

            <div class="player">

                <h3>⭐ ${speler.naam}</h3>

                <p>
                    Club: ${speler.club}
                </p>

                <p>
                    ${speler.positie} •
                    Rating ${speler.rating}
                </p>

                <p>
                    💰 €${speler.prijs}M
                </p>

                <button
                    onclick="koopSpeler('${speler.naam}')"
                    ${alInSelectie ? "disabled" : ""}
                >
                    ${alInSelectie
                        ? "✅ In selectie"
                        : "🔄 Kopen"}
                </button>

            </div>

            `;

        });

}


/* =========================
   SPELER KOPEN
========================= */

function koopSpeler(naam) {

    let speler =
        spelers.find(
            p => p.naam === naam
        );

    if (!speler) return;

    if (mijnSelectie.some(
        p => p.naam === speler.naam
    )) {

        alert("Deze speler zit al in je selectie!");

        return;
    }

    if (budget < speler.prijs) {

        alert("❌ Niet genoeg transferbudget!");

        return;
    }

    budget -= speler.prijs;

    mijnSelectie.push({
        ...speler
    });

    alert(
        "✅ " +
        speler.naam +
        " is gekocht!"
    );

    updateStatus();
    toonTransfers();
    toonSelectie();

}


/* =========================
   SPELER VERKOPEN
========================= */

function verkoopSpeler(index) {

    let speler =
        mijnSelectie[index];

    if (!speler) return;

    let verkoopprijs =
        Math.round(speler.prijs * 0.7);

    budget += verkoopprijs;

    mijnSelectie.splice(index, 1);

    alert(
        "💰 " +
        speler.naam +
        " verkocht voor €" +
        verkoopprijs +
        "M!"
    );

    updateStatus();
    toonSelectie();

}


/* =========================
   WEDSTRIJD VERWERKEN
========================= */

function verwerkWedstrijd(
    thuis,
    uit,
    goalsThuis,
    goalsUit
) {

    thuis.WG++;
    uit.WG++;

    thuis.DV += goalsThuis;
    thuis.DT += goalsUit;

    uit.DV += goalsUit;
    uit.DT += goalsThuis;

    if (goalsThuis > goalsUit) {

        thuis.W++;
        uit.V++;

    } else if (goalsThuis < goalsUit) {

        uit.W++;
        thuis.V++;

    } else {

        thuis.G++;
        uit.G++;

    }

}


/* =========================
   SPEELDAG
========================= */

function speelSpeeldag() {

    if (!mijnClub) {

        alert("Start eerst een carrière!");

        return;
    }

    if (speeldag >= 38) {

        eindeSeizoen();

        return;
    }

    speeldag++;

    let mijnTeam =
        competitie.find(
            c => c.club === mijnClub
        );

    let tegenstanders =
        competitie.filter(
            c => c.club !== mijnClub
        );

    let tegenstander =
        tegenstanders[
            Math.floor(
                Math.random() *
                tegenstanders.length
            )
        ];

    let mijnGoals =
        Math.floor(Math.random() * 5);

    let tegenGoals =
        Math.floor(Math.random() * 5);

    verwerkWedstrijd(
        mijnTeam,
        tegenstander,
        mijnGoals,
        tegenGoals
    );


    // Andere wedstrijden
    let andereTeams =
        competitie.filter(
            c =>
                c.club !== mijnClub &&
                c.club !== tegenstander.club
        );

    andereTeams.sort(
        () => Math.random() - 0.5
    );

    let resultaten = "";

    while (andereTeams.length >= 2) {

        let thuis =
            andereTeams.shift();

        let uit =
            andereTeams.shift();

        let goalsThuis =
            Math.floor(Math.random() * 5);

        let goalsUit =
            Math.floor(Math.random() * 5);

        verwerkWedstrijd(
            thuis,
            uit,
            goalsThuis,
            goalsUit
        );

        resultaten += `
            <p>
                ⚽ ${thuis.club}
                ${goalsThuis}-${goalsUit}
                ${uit.club}
            </p>
        `;

    }


    document.getElementById("wedstrijd")
        .innerHTML = `

        <div class="card">

            <h2>
                📅 Speeldag ${speeldag}
            </h2>

            <h3>
                ${mijnClub}
                ${mijnGoals}
                -
                ${tegenGoals}
                ${tegenstander.club}
            </h3>

            <hr>

            <h3>
                🤖 Andere wedstrijden
            </h3>

            ${resultaten}

        </div>

        `;

    updateStatus();
    toonStand();

}


/* =========================
   EXTRA WEDSTRIJD
========================= */

function nieuweWedstrijd() {

    alert(
        "Gebruik 'Speel volgende speeldag' om het seizoen eerlijk te laten verlopen."
    );

}


/* =========================
   STAND
========================= */

function toonStand() {

    competitie.forEach(team => {

        team.DS =
            team.DV -
            team.DT;

        team.Ptn =
            team.W * 3 +
            team.G;

    });


    competitie.sort((a, b) => {

        if (b.Ptn !== a.Ptn)
            return b.Ptn - a.Ptn;

        if (b.DS !== a.DS)
            return b.DS - a.DS;

        return b.DV - a.DV;

    });


    let html = `

    <table>

        <tr>
            <th>#</th>
            <th>Club</th>
            <th>WG</th>
            <th>W</th>
            <th>G</th>
            <th>V</th>
            <th>DV</th>
            <th>DT</th>
            <th>DS</th>
            <th>Ptn</th>
        </tr>

    `;


    competitie.forEach((team, index) => {

        let klasse =
            team.club === mijnClub
                ? "highlight"
                : "";

        html += `

        <tr class="${klasse}">

            <td>
                ${index + 1}
            </td>

            <td>
                ${team.club}
            </td>

            <td>
                ${team.WG}
            </td>

            <td>
                ${team.W}
            </td>

            <td>
                ${team.G}
            </td>

            <td>
                ${team.V}
            </td>

            <td>
                ${team.DV}
            </td>

            <td>
                ${team.DT}
            </td>

            <td>
                ${team.DS}
            </td>

            <td>
                <b>${team.Ptn}</b>
            </td>

        </tr>

        `;

    });


    html += "</table>";

    document.getElementById("standTabel")
        .innerHTML = html;

}


/* =========================
   EINDE SEIZOEN
========================= */

function eindeSeizoen() {

    toonStand();

    let kampioen =
        competitie[0];

    if (kampioen.club === mijnClub) {

        titels++;

        alert(
            "🏆 KAMPIOEN!\n\n" +
            mijnClub +
            " heeft de competitie gewonnen!"
        );

    } else {

        alert(
            "🏁 Seizoen afgelopen!\n\n" +
            "Kampioen: " +
            kampioen.club
        );

    }

    seizoen++;

    speeldag = 0;

    // Nieuwe transferperiode
    budget += 50;

    // Stand resetten
    competitie.forEach(team => {

        team.WG = 0;
        team.W = 0;
        team.G = 0;
        team.V = 0;
        team.DV = 0;
        team.DT = 0;
        team.DS = 0;
        team.Ptn = 0;

    });

    document.getElementById("status")
        .innerText =
        mijnClub +
        " • Seizoen " +
        seizoen;

    updateStatus();
    toonStand();

}


/* =========================
   NIEUWS
========================= */

function toonNieuws() {

    let box =
        document.getElementById("nieuwsLijst");

    box.innerHTML = `

        <div class="player">
            📰 <b>Transfernieuws</b>
            <p>
            Clubs zijn druk bezig op de transfermarkt.
            </p>
        </div>

        <div class="player">
            ⚽ <b>Competitienieuws</b>
            <p>
            ${mijnClub || "Jouw club"}
            maakt zich klaar voor de volgende wedstrijd.
            </p>
        </div>

        <div class="player">
            🌍 <b>Wereldvoetbal</b>
            <p>
            De strijd om de titel is begonnen!
            </p>
        </div>

    `;

}


/* =========================
   START
========================= */

toonStand();
updateStatus();
toonNieuws();

</script>

</body>
</html>